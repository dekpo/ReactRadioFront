VITE_GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com

# Sign in with Apple — Services ID + Return URL registered in Apple Developer
# (Identifiers → Services IDs → Sign In with Apple → Configure). Must match
# exactly; Apple requires HTTPS. Localhost usually won't work for the popup.
VITE_APPLE_CLIENT_ID=com.yologaza.radio.web
VITE_APPLE_REDIRECT_URI=https://radio.yologaza.com
